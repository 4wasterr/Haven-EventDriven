DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=registration_system
PORT=5000
HOST=127.0.0.1

# Application origin for secure requests and existing verification/unlock links.
PUBLIC_APP_URL=http://localhost:5173

# Brevo transactional emails. Use a sender verified in your Brevo account.
BREVO_API_KEY=
SENDER_NAME=Haven
SENDER_EMAIL=

# iProg SMS. API base URL; Haven appends /sms_messages.
IPROG_API_URL=https://www.iprogsms.com/api/v1
IPROG_API_TOKEN=
# Request/approve the Haven sender name in your iProg account.

# Calendarific Philippine holidays (2020-2027). Keep this key server-side.
CALENDARIFIC_API_KEY=

# Production requires HTTPS with TLS 1.3.
# NODE_ENV=production
# PUBLIC_APP_URL=https://your-application.example
# CSRF_SECRET=replace_with_a_random_secret_at_least_32_characters_long
# TLS_CERT_FILE=/absolute/path/to/certificate.pem
# TLS_KEY_FILE=/absolute/path/to/private-key.pem
# Or use a trusted reverse proxy that enforces TLS 1.3:
# TRUST_PROXY=1
# The proxy must overwrite X-TLS-Version with its negotiated TLS protocol
# (TLSv1.3) and X-Forwarded-Proto with https. Keep the backend private.
