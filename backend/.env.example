DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=registration_system
PORT=5000
HOST=127.0.0.1

# Resend is the only email provider. Create the key at https://resend.com/api-keys.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_REAL_KEY
# Test sender: only delivers to the email address associated with your Resend account.
RESEND_FROM=onboarding@resend.dev
# For all registered recipients, verify a domain you own at https://resend.com/domains
# and replace RESEND_FROM with an address on that exact verified domain.
# Gmail, Outlook and Yahoo are supported recipients, not domains you can claim as sender.

# Infobip 2FA handles SMS only. Philippines is covered by self-sign-up SMS.
# 60-day trial without a credit card; check free SMS units in Infobip Portal.
# Trial SMS only reaches verified test recipients using the provided trial sender.
# Create an enabled 2FA app: pinAttempts=3, allowMultiplePinVerifications=false,
# pinTimeToLive=5m. Template: pinLength=6, pinType=NUMERIC.
# The Onboarding 2FA key goes in INFOBIP_API_KEY only. Application and message
# IDs come from creating those resources; they are not the other API keys.
INFOBIP_API_KEY=REPLACE_WITH_YOUR_REAL_API_KEY
INFOBIP_BASE_URL=https://YOUR_ACCOUNT.api.infobip.com
INFOBIP_2FA_APPLICATION_ID=REPLACE_WITH_YOUR_2FA_APPLICATION_ID
INFOBIP_2FA_MESSAGE_ID=REPLACE_WITH_YOUR_2FA_MESSAGE_ID

# Verification/unlock links must open the same host used in the browser.
PUBLIC_APP_URL=http://localhost:5173

# Optional holiday provider; Nager.Date is the default.
CALENDARIFIC_API_KEY=

# Production requires HTTPS with TLS 1.3.
# NODE_ENV=production
# PUBLIC_APP_URL=https://your-application.example
# CSRF_SECRET=replace_with_a_random_secret_at_least_32_characters_long
# TLS_CERT_FILE=/absolute/path/to/certificate.pem
# TLS_KEY_FILE=/absolute/path/to/private-key.pem
# Or use a trusted reverse proxy that enforces TLS 1.3:
# TRUST_PROXY=1
